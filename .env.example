# JWT Secret
JWT_SECRET=your-jwt-secret-key-here

# Firebase Configuration
FIREBASE_PROJECT_ID=avancapj-d2395
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# Use a single line; escaping new lines with \n also works without surrounding quotes
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n
# Optionally paste the full JSON of the service account or a path to the file
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_JSON=/absolute/path/to/serviceAccount.json

FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@avancapj-d2395.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# Server Configuration
PORT=3000

